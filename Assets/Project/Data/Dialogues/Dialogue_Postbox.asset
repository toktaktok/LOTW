  m_Script: {fileID: 11500000, guid: d1e2f3a4b5c6078901234567890abcd1, type: 3}
  m_Name: Dialogue_Postbox
  m_EditorClassIdentifier: Assembly-CSharp::Project.Scripts.Data.DialogueDatabase
  data:
    lines:
    - speaker: "\uC6B0\uCCB4\uD1B5"
      text: "\uD3B8\uC9C0\uAC00 \uC654\uC5B4! \uC624\uB298\uC740 \uB450 \uD1B5\uC774\uB098 \uB4E4\uC5B4\uC788\uC5B4."
    - speaker: "\uC6B0\uCCB4\uD1B5"
      text: "\uD558\uB098\uB294 \uAC15 \uAC74\uB108\uD3B8 \uB9C8\uC744\uC5D0\uC11C, \uD558\uB098\uB294... \uBC1C\uC2E0\uC778\uC774 \uC5C6\uB124."
    - speaker:
      text: "(\uC6B0\uCCB4\uD1B5 \uC785\uAD6C\uAC00 \uBE60\uAE5F\uBE60\uAE5F \uC5F4\uB9AC\uACE0 \uB2EB\uD78C\uB2E4.)"
    - speaker: "\uC6B0\uCCB4\uD1B5"
      text: "\uAC00\uC838\uAC00\uB824\uBA74 \uAC00\uC838\uAC00. \uB098\uB294 \uBCF4\uAD00\uB9CC \uD558\uB294 \uAC70\uB2C8\uAE4C."
