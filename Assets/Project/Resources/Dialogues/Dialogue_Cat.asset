  data:
    lines:
    - speaker: "\uACE0\uC591\uC774"
      text: "\uC74C... \uB610 \uC654\uC5B4?"
    - speaker: "\uACE0\uC591\uC774"
      text: "\uB098\uB294 \uC774 \uC9C0\uBD95 \uC704\uAC00 \uC88B\uAC70\uB4E0. \uD574\uAC00 \uC798 \uB4E4\uC5B4."
    - speaker:
      text: "(\uACE0\uC591\uC774\uAC00 \uD558\uD488\uC744 \uD558\uBA70 \uAE30\uC9C0\uAC1C\uB97C \uD3B8\uB2E4.)"
    - speaker: "\uACE0\uC591\uC774"
      text: "\uBB50, \uBD80\uD0C1\uD560 \uAC70\uB77C\uB3C4 \uC788\uC5B4? \uADC0\uCC2E\uC73C\uBA74 \uC0DD\uC120 \uD55C \uB9C8\uB9AC \uAC00\uC838\uC640."
