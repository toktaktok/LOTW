  m_Script: {fileID: 11500000, guid: d1e2f3a4b5c6078901234567890abcd1, type: 3}
  m_Name: Dialogue_Elder
  m_EditorClassIdentifier: Assembly-CSharp::Project.Scripts.Data.DialogueDatabase
  data:
    lines:
    - speaker: "\uC7A5\uB85C"
      text: "\uC5B4\uC11C \uC624\uAC8C, \uC80A\uC740\uC774\uC5EC. \uC774 \uB9C8\uC744\uC5D0 \uBC29\uBB38\uD55C \uAC83\uC740 \uCC98\uC74C\uC774\uAD70."
    - speaker: "\uC7A5\uB85C"
      text: "\uC624\uB798\uC804\uBD80\uD130 \uC774\uACF3\uC744 \uC9C0\uD0A4\uACE0 \uC788\uC9C0. \uBB3C\uC5B4\uBCFC \uAC83\uC774 \uC788\uB2E4\uBA74 \uD3B8\uD558\uAC8C \uB9D0\uD558\uAC8C."
    - speaker: "\uC7A5\uB85C"
      text: "\uD558\uC9C0\uB9CC \uC870\uC2EC\uD558\uAC8C. \uB9C8\uC744 \uBC16\uC758 \uC138\uACC4\uB294 \uC608\uC804 \uAC19\uC9C0 \uC54A\uC73C\uB2C8."
