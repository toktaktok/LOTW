  m_Script: {fileID: 11500000, guid: d1e2f3a4b5c6078901234567890abcd1, type: 3}
  m_Name: Dialogue_Merchant
  m_EditorClassIdentifier: Assembly-CSharp::Project.Scripts.Data.DialogueDatabase
  data:
    lines:
    - speaker: "\uC0C1\uC778"
      text: "\uC5B4\uC11C \uC640! \uC624\uB298\uB3C4 \uC88B\uC740 \uBB3C\uAC74\uC774 \uB9CE\uC774 \uB4E4\uC5B4\uC654\uB2E4\uACE0."
    - speaker: "\uC0C1\uC778"
      text: "\uC5EC\uD589\uC5D0 \uD544\uC694\uD55C \uAC83\uC774 \uC788\uC73C\uBA74 \uB9D0\uD574\uBD10. \uC2F8\uAC8C \uD574\uC904\uAC8C."
    - speaker:
      text: "(\uC0C1\uC778\uC758 \uC9C4\uC5F4\uB300 \uC704\uC5D0 \uB2E4\uC591\uD55C \uBB3C\uAC74\uC774 \uB194\uC5EC \uC788\uB2E4.)"
    - speaker: "\uC0C1\uC778"
      text: "\uAD6C\uACBD\uB9CC \uD558\uB294 \uAC83\uB3C4 \uD658\uC601\uC774\uC57C, \uD558\uD558!"
