# LOTW formatting conventions (see .claude/rules/csharp-conventions.md)
root = true

[*]
charset = utf-8
# Working copies are CRLF (core.autocrlf=true); .gitattributes normalizes to LF in the repo.
end_of_line = crlf
# insert_final_newline is intentionally unset: many existing files have none, avoid churn.

[*.cs]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Control flow: if(x), for(...), while(...), switch(...), catch(...), using(...)
csharp_space_after_keywords_in_control_flow_statements = false

# Allman braces
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Single-statement bodies go on the next line without braces
csharp_prefer_braces = false:silent

csharp_space_after_cast = false
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false

# Naming: no private-field rule on purpose. Private non-serialized fields use _camelCase but
# [SerializeField] private fields use plain camelCase; .editorconfig cannot tell them apart
# (attributes are not matchable), so any rule would produce false positives.

# Generated code
[Assets/Project/Scripts/System/World/InputSystem_Actions.cs]
generated_code = true
