  data:
    lines:
    - speaker: "\uB298\uC740 \uB098\uBB34"
      text: "...\uBC14\uB78C\uC774 \uBD88\uC5B4\uC624\uB294\uAD70."
    - speaker: "\uB298\uC740 \uB098\uBB34"
      text: "\uB098\uB294 \uC5EC\uAE30 \uBFCC\uB9AC\uB97C \uB0B4\uB9B0 \uC9C0 \uBC31 \uD574\uAC00 \uB118\uC5C8\uC5B4. \uC774 \uB9C8\uC744\uC758 \uBAA8\uB4E0 \uAC83\uC744 \uBCF4\uC544\uC654\uC9C0."
    - speaker:
      text: "(\uB098\uBB47\uC78E \uC0AC\uC774\uB85C \uBD80\uB4DC\uB7EC\uC6B4 \uD587\uBE5B\uC774 \uC3DF\uC544\uC9C4\uB2E4.)"
    - speaker: "\uB298\uC740 \uB098\uBB34"
      text: "\uCC9C\uCC9C\uD788 \uB458\uB7EC\uBD10. \uAE09\uD560 \uAC83 \uC5C6\uC73C\uB2C8\uAE4C."
