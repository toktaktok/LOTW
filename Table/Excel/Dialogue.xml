<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
          xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
          xmlns:x="urn:schemas-microsoft-com:office:excel">
  <Worksheet ss:Name="Dialogue">
    <Table>
      <!--
        ※ 표(AutoFilter) 범위: R1C1:R6C6
           Row  1    = 헤더
           Row  2~6  = 데이터 (5개)
           Col  1~6  = DataId, SpeakerId, SpeakerName, Text, NextId, ChoiceIds

        헤더 명명 규칙:
          첫 글자 대문자 + 나머지 카멜케이스 (C# 필드명과 동일하게)
          DataId, SpeakerId, SpeakerName, Text, NextId, ChoiceIds

        dataId 규칙:
          반드시 정수여야 함. 공백·문자열 행은 자동 제외 (설명 행 자유 추가 가능)

        ChoiceIds 규칙:
          선택지가 있으면 쉼표로 구분된 정수 목록 작성 (예: "2,3")
          없으면 빈 셀로 두기
      -->

      <!-- ─── 헤더 행 ─── -->
      <Row>
        <Cell><Data ss:Type="String">DataId</Data></Cell>
        <Cell><Data ss:Type="String">SpeakerId</Data></Cell>
        <Cell><Data ss:Type="String">SpeakerName</Data></Cell>
        <Cell><Data ss:Type="String">Text</Data></Cell>
        <Cell><Data ss:Type="String">NextId</Data></Cell>
        <Cell><Data ss:Type="String">ChoiceIds</Data></Cell>
      </Row>

      <!-- ─── 데이터 행 ─── -->
      <!-- 상점 주인 첫 인사 (선택지로 분기) -->
      <Row>
        <Cell><Data ss:Type="Number">1</Data></Cell>
        <Cell><Data ss:Type="String">npc_shopkeeper</Data></Cell>
        <Cell><Data ss:Type="String">상점 주인</Data></Cell>
        <Cell><Data ss:Type="String">어서오세요! 무엇을 도와드릴까요?</Data></Cell>
        <Cell><Data ss:Type="Number">-1</Data></Cell>
        <Cell><Data ss:Type="String">2,3</Data></Cell>
      </Row>
      <!-- 선택지 1: 꽃 구경 -->
      <Row>
        <Cell><Data ss:Type="Number">2</Data></Cell>
        <Cell><Data ss:Type="String">player</Data></Cell>
        <Cell><Data ss:Type="String">플레이어</Data></Cell>
        <Cell><Data ss:Type="String">꽃을 좀 구경해도 될까요?</Data></Cell>
        <Cell><Data ss:Type="Number">4</Data></Cell>
        <Cell></Cell>
      </Row>
      <!-- 선택지 2: 그냥 지나침 -->
      <Row>
        <Cell><Data ss:Type="Number">3</Data></Cell>
        <Cell><Data ss:Type="String">player</Data></Cell>
        <Cell><Data ss:Type="String">플레이어</Data></Cell>
        <Cell><Data ss:Type="String">아니요, 그냥 지나가는 길이에요.</Data></Cell>
        <Cell><Data ss:Type="Number">5</Data></Cell>
        <Cell></Cell>
      </Row>
      <!-- 선택지 1 이후 상점 주인 반응 -->
      <Row>
        <Cell><Data ss:Type="Number">4</Data></Cell>
        <Cell><Data ss:Type="String">npc_shopkeeper</Data></Cell>
        <Cell><Data ss:Type="String">상점 주인</Data></Cell>
        <Cell><Data ss:Type="String">물론이죠! 오늘 들어온 장미가 특히 예쁘답니다.</Data></Cell>
        <Cell><Data ss:Type="Number">-1</Data></Cell>
        <Cell></Cell>
      </Row>
      <!-- 선택지 2 이후 상점 주인 반응 -->
      <Row>
        <Cell><Data ss:Type="Number">5</Data></Cell>
        <Cell><Data ss:Type="String">npc_shopkeeper</Data></Cell>
        <Cell><Data ss:Type="String">상점 주인</Data></Cell>
        <Cell><Data ss:Type="String">그렇군요. 또 들러주세요!</Data></Cell>
        <Cell><Data ss:Type="Number">-1</Data></Cell>
        <Cell></Cell>
      </Row>
    </Table>

    <!--
      AutoFilter: 표 범위 정의 (Excel [삽입 > 표]로 생성되는 형식)
      R1C1:R6C6 = 헤더 포함 6행 × 6열
      ※ 표 범위를 벗어난 셀은 변환 시 무시됩니다.
    -->
    <AutoFilter x:Range="R1C1:R6C6" xmlns="urn:schemas-microsoft-com:office:excel"/>
  </Worksheet>
</Workbook>
